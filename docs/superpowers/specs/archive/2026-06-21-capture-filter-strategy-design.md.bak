## 4. Loader 与文件发现

### 4.1 公共 API

```python
# gimbal/capture/loader.py

def build_matcher(
    *,
    filter_file: Optional[Path],
    profile: Optional[str],
    cli_csv: Optional[str],
    cli_mode: FilterMode,
    strict_files_only: bool = False,
) -> CompiledMatcher:
    """端到端入口：CLI 参数 → CompiledMatcher。"""
```

### 4.2 文件发现

```python
def _default_search_paths() -> tuple[Optional[Path], ...]:
    env = os.environ.get("GIMBAL_FILTERS")
    return (
        Path.cwd() / ".gimbal" / "filters.yaml",
        Path.cwd() / "filters.yaml",
        Path.home() / ".gimbal" / "filters.yaml",
        Path(env).expanduser() if env else None,
    )


def discover_filter_file(
    explicit: Optional[Path],
    search_paths: tuple[Optional[Path], ...],
    strict: bool,
) -> Optional[Path]:
    """--filter-file 优先；否则按 search_paths 找第一个存在的文件。

    strict=True 且未找到 → FilterFileNotFound。
    """
    if explicit is not None:
        p = explicit.expanduser().resolve()
        if not p.exists():
            raise FilterFileNotFound(f"--filter-file 指定的文件不存在: {p}")
        return p
    for p in search_paths:
        if p and p.exists():
            return p
    if strict:
        raise FilterFileNotFound(
            "未找到 filter 文件 (--strict-files-only 已启用)"
        )
    return None
```

### 4.3 include 解析

```python
def resolve_includes(
    main_path: Path,
    visited: frozenset[Path] = frozenset(),
) -> StrategyFile:
    """递归加载 main_path + 它的 includes。

    - 已访问集合在函数边界检测，发现环 → IncludeCycleError
    - include 路径以**主文件所在目录**为基准（不是 CWD）
    - 跨文件 profile 不合并语义：后者覆盖前者，发出警告
    - 顶层 mode / default_profile / includes 只用 main 文件的；
      included 文件仅追加自己的 profiles
    """
    abs_main = main_path.resolve()
    if abs_main in visited:
        raise IncludeCycleError(f"include 循环: {abs_main}")

    sf = _load_one_yaml(main_path)

    for inc in sf.includes:
        inc_abs = (main_path.parent / inc).resolve()
        inc_sf = resolve_includes(inc_abs, visited | {abs_main})
        for name, prof in inc_sf.profiles.items():
            if name in sf.profiles:
                typer.secho(
                    f"[filter] 警告: profile {name!r} 被覆盖 "
                    f"(来源: {inc.name})",
                    fg=typer.colors.YELLOW,
                )
            sf.profiles[name] = prof
    return sf
```

### 4.4 profile 选择

```python
def select_profile(sf: StrategyFile, name: Optional[str]) -> Profile:
    chosen = name or sf.default_profile
    if chosen is None:
        if len(sf.profiles) == 1:
            return next(iter(sf.profiles.values()))
        raise ProfileNotFound(
            f"文件含 {len(sf.profiles)} 个 profile，必须 --filter-profile 指定，"
            f"或文件内设置 default_profile"
        )
    if chosen not in sf.profiles:
        raise ProfileNotFound(
            f"profile {chosen!r} 不存在，文件中只有: {list(sf.profiles)}"
        )
    return sf.profiles[chosen]
```

### 4.5 CLI 追加规则

```python
def append_cli_rules(
    profile: Profile,
    csv: Optional[str],
    cli_mode: FilterMode,
) -> None:
    """把 --filter '/a,/b' 转成 Rule 列表，追加到 profile.rules 末尾。

    每条 CSV 元素 → Rule(path=p, mode=cli_mode)。
    空 csv → 不追加（保留纯文件行为）。
    """
    if not csv:
        return
    for p in csv.split(","):
        p = p.strip()
        if not p:
            continue
        profile.rules.append(Rule(path=p, mode=cli_mode))
```

### 4.6 编译

```python
def compile_matcher(sf: StrategyFile, profile: Profile) -> CompiledMatcher:
    """把 Profile.rules 编译成 CompiledMatcher。

    每条 Rule：
      - 解析 mode（None → 继承 sf.mode）
      - 编译 host_glob / host_regex / path_glob / path_regex 为 re.Pattern
      - methods → frozenset
    编译失败的规则 → RuleCompileError，提示字段名 + 原因 + rule 索引。
    """
    compiled = []
    for idx, rule in enumerate(profile.rules):
        try:
            compiled.append(_compile_one(idx, rule, sf.mode))
        except re.error as e:
            raise RuleCompileError(
                f"profile rule #{idx + 1} 正则编译失败: {e}\n"
                f"  rule: {rule.model_dump_json(indent=2)}"
            )
    return CompiledMatcher(compiled)


def _compile_one(idx: int, rule: Rule, default_mode: FilterMode) -> CompiledRule:
    mode = rule.mode or default_mode
    host_re = _compile_host(rule)
    path_prefix, path_re = _compile_path(rule)
    methods = frozenset(rule.methods) if rule.methods else None
    return CompiledRule(
        mode=mode, host=host_re, path_prefix=path_prefix,
        path_re=path_re, methods=methods,
    )


def _compile_host(rule: Rule) -> Optional[re.Pattern]:
    if rule.host:
        return re.compile(re.escape(rule.host))
    if rule.host_glob:
        return re.compile(fnmatch.translate(rule.host_glob))
    if rule.host_regex:
        return re.compile(rule.host_regex)
    return None


def _compile_path(rule: Rule) -> tuple[Optional[str], Optional[re.Pattern]]:
    if rule.path:
        return rule.path, None
    if rule.path_glob:
        return None, re.compile(fnmatch.translate(rule.path_glob))
    if rule.path_regex:
        return None, re.compile(rule.path_regex)
    return None, None
```

### 4.7 旧行为兜底

```python
def build_matcher(*, filter_file, profile, cli_csv, cli_mode,
                  strict_files_only=False) -> CompiledMatcher:
    """CLI 参数 → CompiledMatcher。

    三条入口分支：
      A. 显式文件存在 + profile.rules 非空 → 编译文件规则
      B. 文件存在但 profile.rules 为空 且 无 CSV → EmptyRulesError（不录所有）
      C. 找不到文件 且 无 CSV → 旧行为兜底：插入一条 "全匹配" sentinel 规则，
         等价于 PathFilter([]).match() == True，保留 v0 "什么都不配就全录" 语义
      D. 找不到文件 但有 CSV → 纯 CSV 路径
    """
    sf = _load_strategy_file_or_none(filter_file, strict_files_only)
    if sf is None:
        if not cli_csv:
            # 兜底：全匹配（v0 PathFilter([]) 等价行为）
            return CompiledMatcher([CompiledRule(
                mode=FilterMode.INCLUDE,
                host=None, path_prefix=None, path_re=None, methods=None,
            )])
        return CompiledMatcher([
            _compile_csv_rule(p, cli_mode) for p in parse_csv(cli_csv)
        ])
    sf = resolve_includes(sf)
    prof = select_profile(sf, profile)
    append_cli_rules(prof, cli_csv, cli_mode)
    if not prof.rules:
        raise EmptyRulesError(
            f"选中的 profile 无任何规则，请至少 1 条或加 --filter"
        )
    return compile_matcher(sf, prof)
```

### 4.8 异常体系

```python
class FilterConfigError(Exception):
    """筛选配置错误，父进程捕到 → 退出码 5 + 红字。"""

class FilterFileNotFound(FilterConfigError): ...
class IncludeCycleError(FilterConfigError): ...
class ProfileNotFound(FilterConfigError): ...
class RuleCompileError(FilterConfigError): ...
class EmptyRulesError(FilterConfigError): ...
```

