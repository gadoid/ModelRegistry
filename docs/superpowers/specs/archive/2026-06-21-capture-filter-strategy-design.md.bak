## 5. CLI 接口

### 5.1 新增 typer 参数

```python
def start_cmd(
    session: str = typer.Option(..., "--session", "-s"),
    port: int = typer.Option(8080, "--port", "-p"),
    filter: str = typer.Option("/api/", "--filter", "-f"),
    home: Optional[Path] = typer.Option(None, "--home"),
    mitmdump: str = typer.Option("mitmdump"),
    # ── 新增 ──
    filter_file: Optional[Path] = typer.Option(
        None, "--filter-file",
        help="YAML 筛选配置文件；未传则按 .gimbal/filters.yaml 等自动查找",
    ),
    filter_profile: Optional[str] = typer.Option(
        None, "--filter-profile",
        help="要使用的 profile 名；多 profile 时必填",
    ),
    filter_mode: FilterMode = typer.Option(
        FilterMode.INCLUDE, "--filter-mode",
        help="CLI --filter 追加规则的默认 mode",
    ),
    strict_files_only: bool = typer.Option(
        False, "--strict-files-only",
        help="关闭自动文件查找，只用 --filter-file",
    ),
) -> None:
```

### 5.2 优先级与互斥

```
--filter-file 显式         → 用该文件，跳过自动查找
--strict-files-only        → 关闭自动查找，没传 file 就报 FilterFileNotFound
--filter-profile X         → 必须存在于文件 profiles
文件含 default_profile     → 未传 --filter-profile 时使用
文件只 1 个 profile        → 自动选（无需 --filter-profile）
--filter '/api/x,/api/y'   → 追加为 Rule，mode 由 --filter-mode 决定
```

### 5.3 旧命令兼容

```bash
# 旧用法，完全不变（CSV 默认 mode=include，无文件）
gimbal capture start --session dev-1 --filter /api/    # ✓ 工作
gimbal capture start --session dev-1 --filter ""       # ✓ 不过滤

# 新用法
gimbal capture start --session dev-1 \
  --filter-file filters.yaml \
  --filter-profile smoke

gimbal capture start --session dev-1 \
  --filter-file filters.yaml \
  --filter-profile smoke \
  --filter "/api/debug" \
  --filter-mode include

gimbal capture start --session dev-1 \
  --strict-files-only \
  --filter-file filters.yaml
```

### 5.4 addon 脚本渲染

mitmdump 子进程需要**自己加载** matcher（不能传对象）。改造 `_render_addon_script`：

```python
def _render_addon_script(
    home: Path,
    session: str,
    *,
    filter_file: Optional[Path],
    filter_profile: Optional[str],
    cli_csv: str,
    cli_mode: str,
) -> str:
    home_s = str(home).replace("\\", "\\\\")
    filter_csv_s = cli_csv.replace("\\", "\\\\").replace('"', '\\"')
    file_repr = (
        f'r"{str(filter_file).replace(chr(92), chr(92)*2)}"'
        if filter_file else "None"
    )
    profile_repr = f'"{filter_profile}"' if filter_profile else "None"

    return f'''
# Auto-generated by gimbal capture; do not edit.
import sys
from pathlib import Path

sys.path.insert(0, r"{Path(__file__).resolve().parent.parent.parent.parent}")

from gimbal.capture.loader import build_matcher
from gimbal.capture.bus import FileBus
from gimbal.capture.proxy import CaptureAddon

home = Path(r"{home_s}")
session = "{session}"
cli_csv = "{filter_csv_s}"
cli_mode = "{cli_mode}"

matcher = build_matcher(
    filter_file={file_repr},
    profile={profile_repr},
    cli_csv=cli_csv,
    cli_mode=FilterMode(cli_mode),
)

bus = FileBus(home, session)
addons = [CaptureAddon(bus, matcher)]
'''
```

### 5.5 父进程提前校验

```python
# cli.py:start_cmd
try:
    matcher = build_matcher(
        filter_file=filter_file,
        profile=filter_profile,
        cli_csv=filter,
        cli_mode=filter_mode,
        strict_files_only=strict_files_only,
    )
except FilterConfigError as e:
    typer.secho(
        f"[capture] 筛选配置错误: {e}",
        fg=typer.colors.RED, err=True,
    )
    raise typer.Exit(5)

typer.echo(f"[capture] filter rules: {len(matcher.rules)}")

addon_script = _render_addon_script(
    home, session,
    filter_file=filter_file,
    filter_profile=filter_profile,
    cli_csv=filter,
    cli_mode=filter_mode.value,
)
```

**好处**：父进程先 build 一次能立刻发现 YAML 错、正则错、循环 include；mitmdump 子进程再 build 是冗余但保证隔离（重 IPC 风险）。

### 5.6 proxy.py 改造

```python
# gimbal/capture/proxy.py
class CaptureAddon:
    def __init__(self, bus: FileBus, matcher: CompiledMatcher) -> None:
        self.bus = bus
        self.matcher = matcher
        self.count = 0

    def response(self, flow: http.HTTPFlow):
        if flow.response is None:
            return
        path = flow.request.path.split("?")[0]
        event = self._build_event_dict(flow, path)
        if not self.matcher.match(event):
            return
        # ... 转 CaptureEvent + bus.write
```

**`PathFilter` 兼容层保留**：

```python
# filter.py 末尾保留
class PathFilter:
    """CSV-only 兼容层。给没传 --filter-file 的旧命令使用。

    新代码应走 loader.build_matcher + CompiledMatcher。
    """
    # ... 现有代码不变
```

