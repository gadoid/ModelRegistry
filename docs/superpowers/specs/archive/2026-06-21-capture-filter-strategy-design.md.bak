## 7. 测试策略

### 7.1 测试文件布局

```
tests/
├── test_strategy_model.py        # Pydantic 模型校验（空 rule、互斥、method 大小写）
├── test_strategy_compile.py      # glob/regex 编译、CompiledMatcher.match 语义
├── test_loader_yaml.py           # YAML 解析、StrategyFile 校验
├── test_loader_include.py        # include 递归、覆盖、循环检测、相对路径
├── test_loader_profile.py        # profile 选择、default_profile、多 profile
├── test_loader_cli_override.py   # --filter CSV 追加、--filter-mode
├── test_filter_compat.py         # PathFilter 兼容（现有 CSV 行为不变）
├── test_cli_integration.py       # typer CliRunner 端到端（start / 含错误配置）
└── test_proxy_with_matcher.py    # CaptureAddon + CompiledMatcher（mitmproxy 模拟）
```

### 7.2 单元测试覆盖

**`test_strategy_model.py`**

```python
def test_empty_rule_rejected():
    with pytest.raises(ValidationError, match="至少需要 1 个匹配字段"):
        Rule()

def test_host_mutually_exclusive():
    with pytest.raises(ValidationError, match="只能选一个"):
        Rule(host="x.com", host_glob="*.com")

def test_methods_uppercased():
    r = Rule(methods=["get", "Post"])
    assert r.methods == ["GET", "POST"]

def test_extra_field_rejected():
    with pytest.raises(ValidationError):
        Rule(path="/a", foo="bar")
```

**`test_strategy_compile.py`**

```python
def test_path_prefix_no_false_match():
    """锁住现有 PathFilter 行为：/api/order 不匹配 /api/orderlist"""
    matcher = compile_matcher(_sf(), _profile_with(path="/api/order"))
    assert matcher.match(_ev(path="/api/order"))
    assert matcher.match(_ev(path="/api/order/123"))
    assert not matcher.match(_ev(path="/api/orderlist"))

def test_glob_double_star_recursive():
    matcher = compile_matcher(_sf(), _profile_with(path_glob="/api/**"))
    assert matcher.match(_ev(path="/api/order/123/sub"))
    assert not matcher.match(_ev(path="/other/api"))

def test_and_within_rule():
    """rule 内 host + path + method 全部满足才命中"""
    m = compile_matcher(_sf(mode=INCLUDE), _profile_with(
        host="api.x.com", path="/api/order", methods=["POST"]
    ))
    assert m.match(_ev(host="api.x.com", path="/api/order", method="POST"))
    assert not m.match(_ev(host="api.x.com", path="/api/order", method="GET"))
    assert not m.match(_ev(host="other.com", path="/api/order", method="POST"))

def test_or_between_rules():
    m = compile_matcher(_sf(mode=INCLUDE), _profile_with([
        {"path": "/a"}, {"path": "/b"},
    ]))
    assert m.match(_ev(path="/a/x"))
    assert m.match(_ev(path="/b/x"))
    assert not m.match(_ev(path="/c"))

def test_exclude_mode():
    m = compile_matcher(_sf(mode=EXCLUDE), _profile_with(path="/api/auth/login"))
    assert not m.match(_ev(path="/api/auth/login"))
    assert m.match(_ev(path="/api/order"))
```

**`test_loader_include.py`**

```python
def test_resolve_simple(tmp_path):
    (tmp_path / "_common.yaml").write_text(
        "mode: exclude\nprofiles:\n  _common:\n    rules:\n      - path: /auth\n"
    )
    (tmp_path / "filters.yaml").write_text("""
mode: include
includes: [./_common.yaml]
profiles:
  smoke:
    rules: [{path: /api}]
""")
    sf = resolve_includes(tmp_path / "filters.yaml")
    assert "_common" in sf.profiles
    assert "smoke" in sf.profiles

def test_include_relative_to_main_file(tmp_path):
    sub = tmp_path / "sub"
    sub.mkdir()
    (sub / "common.yaml").write_text("profiles:\n  c:\n    rules: [{path: /a}]")
    (tmp_path / "main.yaml").write_text(
        "includes: [sub/common.yaml]\nprofiles:\n  m:\n    rules: [{path: /b}]"
    )
    sf = resolve_includes(tmp_path / "main.yaml")
    assert {"c", "m"} <= set(sf.profiles)

def test_include_cycle_detected(tmp_path):
    (tmp_path / "a.yaml").write_text(
        "includes: [b.yaml]\nprofiles: {p: {rules: [{path: /a}]}}"
    )
    (tmp_path / "b.yaml").write_text(
        "includes: [a.yaml]\nprofiles: {p: {rules: [{path: /b}]}}"
    )
    with pytest.raises(IncludeCycleError):
        resolve_includes(tmp_path / "a.yaml")

def test_include_profile_override_warns(tmp_path, capsys):
    (tmp_path / "_c.yaml").write_text(
        "profiles:\n  p:\n    rules: [{path: /a}]"
    )
    (tmp_path / "main.yaml").write_text(
        "includes: [_c.yaml]\nprofiles:\n  p:\n    rules: [{path: /b}]"
    )
    resolve_includes(tmp_path / "main.yaml")
    out = capsys.readouterr().err
    assert "profile 'p' 被覆盖" in out
```

**`test_loader_cli_override.py`**

```python
def test_csv_appended_as_rules():
    sf = StrategyFile(mode=INCLUDE, profiles={
        "p": Profile(rules=[Rule(path="/from_file")])
    })
    matcher = build_matcher(filter_file=None, profile=None,
                            cli_csv="/from_cli1,/from_cli2",
                            cli_mode=FilterMode.INCLUDE,
                            _strategy_file=sf)
    assert matcher.match(_ev(path="/from_file"))
    assert matcher.match(_ev(path="/from_cli1"))
    assert matcher.match(_ev(path="/from_cli2"))

def test_cli_csv_uses_cli_mode():
    sf = StrategyFile(mode=INCLUDE, profiles={"p": Profile(rules=[])})
    matcher = build_matcher(filter_file=None, profile=None,
                            cli_csv="/cli", cli_mode=FilterMode.EXCLUDE,
                            _strategy_file=sf)
    assert not matcher.match(_ev(path="/cli"))
    assert matcher.match(_ev(path="/other"))
```

**`test_filter_compat.py`**（回归保护）

```python
def test_csv_default_behavior_unchanged():
    """现有 --filter /api/ 行为必须保持。"""
    matcher = build_matcher(filter_file=None, profile=None,
                            cli_csv="/api/", cli_mode=FilterMode.INCLUDE)
    assert matcher.match(_ev(path="/api/order"))
    assert matcher.match(_ev(path="/api/order/123"))
    assert not matcher.match(_ev(path="/api/orderlist"))
    assert not matcher.match(_ev(path="/static/foo"))


def test_empty_csv_no_file_records_all():
    """v0 行为：--filter "" + 无文件 → 全记录（PathFilter([]) 兜底）。"""
    matcher = build_matcher(filter_file=None, profile=None,
                            cli_csv="", cli_mode=FilterMode.INCLUDE)
    assert matcher.match(_ev(path="/anything"))
    assert matcher.match(_ev(path="/api/order"))
    assert matcher.match(_ev(path="/static/foo"))
```

### 7.3 集成测试

**`test_cli_integration.py`** — typer CliRunner 测 CLI 端到端：

```python
def test_start_with_valid_filter_file(tmp_path, monkeypatch):
    (tmp_path / "filters.yaml").write_text("""
mode: include
profiles:
  smoke:
    rules: [{path: /api}]
""")
    # 跳过 mitmdump，只验证脚本生成与 build_matcher 调用
    result = runner.invoke(app, ["capture", "start", "--session", "x",
                                  "--filter-file", str(tmp_path / "filters.yaml"),
                                  "--filter-profile", "smoke",
                                  "--mitmdump", "/bin/true"])
    assert result.exit_code in (0, 1)  # mitmdump /bin/true 立即退出

def test_invalid_yaml_exits_5(tmp_path):
    (tmp_path / "bad.yaml").write_text("mode: include\n")  # 缺 profiles
    result = runner.invoke(app, ["capture", "start", "--session", "x",
                                  "--filter-file", str(tmp_path / "bad.yaml")])
    assert result.exit_code == 5

def test_missing_profile_exits_5(tmp_path):
    (tmp_path / "f.yaml").write_text("""
mode: include
profiles:
  smoke: {rules: [{path: /a}]}
""")
    result = runner.invoke(app, ["capture", "start", "--session", "x",
                                  "--filter-file", str(tmp_path / "f.yaml"),
                                  "--filter-profile", "nope"])
    assert result.exit_code == 5
    assert "profile 'nope' 不存在" in result.output
```

### 7.4 回归覆盖度目标

- 现有 84 passed 全保留（`test_capture_smoke.py` 验证旧 CSV 仍工作）
- 新增约 30 测试，集中在 edge cases
- 覆盖率目标：`strategy.py` / `loader.py` ≥ 95%

### 7.5 性能/安全注意

- 正则编译在 `build_matcher` 一次完成，运行期只查编译结果
- 不引入用户可控 regex 解析路径的字符串——`path_regex` 必须显式声明
- mitmproxy 子进程是独立进程，addon 加载期任何 import 失败会立即终止

---

## 8. 配置示例

### 8.1 单 profile 简单场景

```yaml
# filters.yaml
mode: include
default_profile: smoke

profiles:
  smoke:
    description: 日常冒烟
    rules:
      - host: api.example.com
        path: /api/order/*
        methods: [POST, PUT]
      - path_glob: /api/v*/order/**
```

### 8.2 include 复用场景

```yaml
# _common.yaml —— 公共黑名单，永不录
mode: exclude
profiles:
  _common:
    rules:
      - path: /api/auth/login
      - path_regex: "^/api/internal/.*"
      - host_regex: "internal\\.example\\.com"
```

```yaml
# filters.yaml —— 团队主配置
mode: include
default_profile: smoke
includes:
  - ./_common.yaml

profiles:
  smoke:
    rules:
      - host: api.example.com
        path_glob: /api/**
  e2e:
    rules:
      - host_glob: "*.example.com"
        path_regex: "^/api/(order|user)/.*"
        methods: [GET, POST]
```

### 8.3 CLI 追加临时调试

```bash
# 在 smoke 基础上临时再录 /api/debug
gimbal capture start --session dev-1 \
  --filter-file filters.yaml \
  --filter-profile smoke \
  --filter "/api/debug" \
  --filter-mode include
```

